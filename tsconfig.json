    "compilerOptions": {
        "target": "ES2022",
        "module": "CommonJS",
        "lib": ["DOM", "DOM.Iterable", "ES2022"],
        "outDir": "./dist",
        "rootDir": "./src",
        "strict": true,
        "declaration": true,
        "esModuleInterop": true,
        "skipLibCheck": true
